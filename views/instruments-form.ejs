<%- include('partials/header', { title: row ? 'แก้ไขเครื่องดนตรี' : 'เพิ่มเครื่องดนตรี' }) %>
<form class="card form narrow" method="post" action="<%= row ? '/app/instruments/' + row.instrument_id + '/update' : '/app/instruments' %>">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <% if (row) { %><input type="hidden" name="version" value="<%= row.version %>"><% } %>
  <label>ชื่อเครื่องดนตรี <input name="name" maxlength="100" value="<%= row ? row.name : '' %>" required></label>
  <label>หมวดหมู่
    <select name="category" required>
      <% Object.entries(CATEGORY).forEach(([k, v]) => { %>
      <option value="<%= k %>" <%= row && row.category === k ? 'selected' : '' %>><%= v[1] %> <%= v[0] %></option>
      <% }) %>
    </select></label>
  <label>คำอธิบาย <textarea name="description" rows="3" maxlength="500"><%= row ? row.description : '' %></textarea></label>
  <div class="two">
    <label>ราคาต่อวัน (บาท) <input type="number" name="daily_price" min="1" max="100000" step="0.01" value="<%= row ? row.daily_price : '' %>" required></label>
    <label>จำนวนคงเหลือ <input type="number" name="stock" min="0" max="1000" value="<%= row ? row.stock : 1 %>" required></label>
  </div>
  <div class="btn-row"><button class="btn primary">บันทึก</button>
    <a class="btn ghost" href="<%= row ? '/app/instruments/' + row.instrument_id : '/app/instruments' %>">ยกเลิก</a></div>
</form>
<%- include('partials/footer') %>
