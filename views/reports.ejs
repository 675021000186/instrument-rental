<%- include('partials/header', { title: 'รายงานสรุปการเช่า' }) %>
<div class="grid cols-3">
  <div class="card stat"><span class="num"><%= baht(revenue) %></span><span>รายได้ (กำลังเช่า + คืนแล้ว)</span></div>
</div>
<div class="grid cols-2">
  <div><h2>จำนวนตามสถานะ</h2>
    <div class="table-wrap"><table>
      <thead><tr><th>สถานะ</th><th>รายการ</th><th>มูลค่า</th></tr></thead>
      <tbody><% byStatus.forEach(s => { %>
        <tr><td><span class="badge <%= STATUS[s.status][1] %>"><%= STATUS[s.status][0] %></span></td><td><%= s.count %></td><td><%= baht(s.amount) %></td></tr>
      <% }) %></tbody></table></div></div>
  <div><h2>เครื่องที่ถูกเช่าบ่อย</h2>
    <div class="table-wrap"><table>
      <thead><tr><th>เครื่องดนตรี</th><th>ครั้ง</th></tr></thead>
      <tbody><% top.forEach(t => { %><tr><td><%= t.name %></td><td><%= t.times %></td></tr><% }) %>
      <% if (!top.length) { %><tr><td colspan="2" class="muted">ยังไม่มีข้อมูล</td></tr><% } %></tbody></table></div></div>
</div>
<%- include('partials/footer') %>
